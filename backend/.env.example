# ─────────────────────────────────────────────────────────────────────────────
# TerraPulse AI — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── JWT / Security ────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── First-run Admin Account ───────────────────────────────────────────────────
# These are used ONLY on the first launch to create the admin user.
# Remove or blank them after first launch.
ADMIN_EMAIL=admin@terrapulse.local
ADMIN_PASSWORD=change-this-admin-password
ADMIN_USERNAME=admin

# ── Dataset Paths ─────────────────────────────────────────────────────────────
PARQUET_DIR=D:\MODIS\MOD13C2_Parquet
DERIVED_DIR=D:\MODIS\Derived

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./terrapulse.db
